{% assign current_time =  'now' | date: "%Y-%m-%d %H:%M:%S"  %}

{% liquid
    if block.settings.media_position == 'left'
        assign render_order = 'media,product-details'
    else
        assign render_order = 'product-details,media'
    endif

    if current_time > block.settings.start_date
        assign status = true
        if block.settings.end_date == blank or current_time < block.settings.end_date
            assign status = true
        else
            assign status = false
        endif
    endif
%}

{% if status == true %}

    {% if block.settings.product != blank %}  
        {% assign render_order_array = render_order | split: ',' %}
        {% capture media %}
            <div
                class="dynamic-prouct-media"
            >
            {%- content_for 'block',
                type: 'dynamic-product-block-media',
                id: 'dynamic-product-block-madia',
                product: block.settings.product
            -%}
            </div>
        {% endcapture %}

        {% capture details %}
            <div class="dynamic-product-details"
                id="dynamic-product-details-{{section.id }}"
                data-applyoffer="{{ block.settings.apply_offer }}"
                data-offer="{{ block.settings.offer }}"
                {% if block.settings.offer == "discount" %}
                    data-discount-type="{{ block.settings.discount_type }}"
                    data-discount="{{ block.settings.discount }}"
                {% endif %}
            >
                {% content_for 'block',
                    type: '_product-details',
                    id: 'product-details',
                    closest.product: block.settings.product
                %}
            </div>
        {% endcapture %}

        {% capture offer_badge %}
            <div class="offer-badge">
                {% if block.settings.apply_offer == true %}
                    {% if block.settings.offer == "discount" %}

                    {% elsif block.settings.offer == "free_shipping" %}

                    {% elsif block.settings.offer == "free_gift" %}
                      
                    {% endif %}
                  
                {% endif %}
            </div>
        {% endcapture %}

        <div class="dynamic-product-block">
            {% for order in render_order_array %}
                {% if order == 'media' %}
                    {{ media }}
                {% elsif order == 'product-details' %}
                    {{ details }}
                    {{ offer_badge }}
                {% endif %}
            {% endfor %}
        </div>

        {% style %}
        .dynamic-product-block {
            display: flex;
            justify-content: center;
            gap: 50px;
            padding: 20px;
            max-width: 1400px;
            margin: auto;
        }

        .dynamic-prouct-media {
            width: 50%;
        }

        .dynamic-product-details {
            width: 35%;
        }

        .dynamic-product-media .media-wrapper {
            max-height: 700px;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .dynamic-product-media .media-wrapper img {
            height: 100%;
            width: auto;
            object-fit: contain;
            left: auto;
            right: auto;
        }

        @media (max-width: 900px) {
            .dynamic-product-block {
                flex-direction: column;
            }

            .dynamic-prouct-media {
                width: 100%;
            }

            .dynamic-product-details {
                width: 100%;
            }
        }
        {% endstyle %}
    {% endif %}

{% endif %}

<script>
    document.addEventListener("DOMContentLoaded", ()=>{
        const dynamicProductDetails = document.querySelector("#dynamic-product-details-{{section.id }}");
        const applyOffer = dynamicProductDetails.dataset.applyoffer;
        if(applyOffer == "true") {
            const offerType = dynamicProductDetails.dataset.offer;
            if(offerType == "discount") {
                const discountType = dynamicProductDetails.dataset.discountType;
                const discount = dynamicProductDetails.dataset.discount;
                if(discountType == "percentage") {
                    const current_price = dynamicProductDetails.querySelector("product-price [ref='priceContainer'] .price");
                    if(current_price) {
                        current_price.textContent = `$${(parseInt(current_price.dataset.price) / 100) - (parseInt(current_price.dataset.price) / 100) * (parseInt(discount) / 100)}`;
                    }
                }
            }
        }
    })
</script>


{% schema %}
{
    "name": "Dynamic Product Block",
    "settings": [
        {
            "type": "product",
            "id": "product",
            "label": "Product"
        },
        {
            "type": "text",
            "id": "start_date",
            "label": "start Date",
            "info": "YY-MM-DD HH:MM:SS"
        },
        {
            "type": "text",
            "id": "end_date",
            "label": "End Date",
            "info": "YY-MM-DD HH:MM:SS"
        },
        {
            "type": "checkbox",
            "id": "apply_offer",
            "label": "Apply offer",
            "default": false
        },
        {   
            "visible_if": "{{ block.settings.apply_offer == true }}",
            "type": "select",
            "label": "Offer",
            "id": "offer",
            "options": [
                {
                    "label": "Discount",
                    "value": "discount"
                },
                {
                    "label": "Free Shipping",
                    "value": "free_shipping"
                },
                {
                    "label": "Free Gift",
                    "value": "free_gift"
                }
            ],
            "default": "discount"
        },
        {
            "visible_if": "{{ block.settings.offer == 'discount' and block.settings.apply_offer == true }}",
            "type": "select",
            "id": "discount_type",
            "label": "Discount type",
            "options": [
                {
                    "label": "Percentage",
                    "value": "percentage"
                },
                {
                    "label": "Fixed",
                    "value": "fixed"
                }
            ],
            "default": "percentage"
        },
        {
            "visible_if": "{{ block.settings.offer == 'discount' and block.settings.apply_offer == true }}",
            "type": "number",
            "id": "discount",
            "label": "Discount"
        },
        {
            "type": "product",
            "id": "gift_product",
            "label": "Gift Product"
        },
        {
            "type": "select",
            "id": "media_position",
            "label": "Media Position",
            "options": [
                {
                "value": "left",
                "label": "Left"
                },
                {
                "value": "right",
                "label": "Right"
                }
            ],
            "default": "left"
        }
    ],
    "presets": [
        {
            "name": "Dynamic Product Block"
        }
    ]
}
{% endschema %}